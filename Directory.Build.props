<Project>

    <!-- The one place the app's version lives. MSBuild applies it to every project in the
         repo (assembly, file and informational version); web/vite.config.ts reads the same
         element and bakes it into the SPA, which shows it next to the logo.
         Bump it by hand for a release; the CI build appends its counter as a fourth part
         (0.0.0.N) by replacing this element before building — see README → Versioning. -->
    <PropertyGroup>
        <Version>1.0.0</Version>
    </PropertyGroup>

</Project>
